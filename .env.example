# Database (port 5434 — must match docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/policylens?schema=public"

# Groq API (free tier - https://console.groq.com)
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_CHAT_MODEL="llama-3.1-8b-instant"

# Gemini (primary extraction provider - https://aistudio.google.com/apikey)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_CHAT_MODEL="gemini-2.0-flash"

# NVIDIA NIM (build.nvidia.com) - dev-only fallback provider.
# WARNING: NVIDIA free-tier terms prohibit personal data; insurance policies are
# personal/health data. Dev-only, never for production.
NVIDIA_API_KEY="your-nvidia-api-key-here"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_EXTRACTION_MODEL="nvidia/llama-3.3-nemotron-super-49b-v1.5"
NVIDIA_CHAT_MODEL="nvidia/llama-3.3-nemotron-super-49b-v1.5"

# OpenRouter (optional — only needed for the translation feature - https://openrouter.ai)
OPENROUTER_API_KEY="your-openrouter-api-key-here"

# Server
PORT=3000
